APP_NAME=AI Interview Platform
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/TEST_DBNAME?sslmode=require

JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
CANDIDATE_REFRESH_DAYS=30
COMPANY_SESSION_HOURS=24

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=put-bcrypt-hash-here

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173

GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-small-en-v1.5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_APP_PASSWORD=your-app-password
EMAIL_FROM_NAME=AI Interview Platform

UPLOAD_DIR=uploads
MAX_CV_MB=5
NOTIFY_ON_REJECTION=false
INTERVIEW_LINK_DAYS=7
RESET_TOKEN_MINUTES=30

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SIGNED_URL_SECONDS=600
MAX_RECORDING_MB=24
MAX_ANSWER_SECONDS=45
FOLLOWUP_COUNT=5
RECORDING_RETENTION_DAYS=90
CONSENT_VERSION=v1
NOTIFY_INTERVIEW_DONE=false
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=en
CANDIDATE_SEE_REPORT=true

MCQ_COUNT=10
MCQ_SECONDS=180
MCQ_GRACE_SECONDS=5
COMBINED_W_R1=0.6
COMBINED_W_R2=0.4
NOTIFY_ROUND2_OPEN=true
NOTIFY_REMINDERS=true
REMINDER_AFTER_DAYS=3
REMINDER_ROUND2_AFTER_DAYS=2
CRON_SECRET=
RETAKE_LIMIT=2
