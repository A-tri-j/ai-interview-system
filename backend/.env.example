APP_NAME=AI Interview Platform
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/TEST_DBNAME?sslmode=require

JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
CANDIDATE_REFRESH_DAYS=30
COMPANY_SESSION_HOURS=24

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=put-bcrypt-hash-here

FRONTEND_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=BAAI/bge-small-en-v1.5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@gmail.com
SMTP_APP_PASSWORD=your-app-password
EMAIL_FROM_NAME=AI Interview Platform

UPLOAD_DIR=uploads
MAX_CV_MB=5
NOTIFY_ON_REJECTION=false
INTERVIEW_LINK_DAYS=7
RESET_TOKEN_MINUTES=30
